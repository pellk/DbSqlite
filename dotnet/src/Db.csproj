<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>nuel.Sqlite</RootNamespace>
		<Version>1.0.0</Version>
		<Company>nuel</Company>
		<Product>DbSqlite</Product>
		<AssemblyName>nuel.DbSqlite</AssemblyName>
		<Authors>Ako Mahmoodi</Authors>
		<PackageId>nuel_DbSqlite</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>SQLite;JSON;CSV</PackageTags>
		<Description>Synchronous SQLite helpers with JSON and compact CSV export for .NET 10.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Db.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
